# Copy this file to .streamlit/secrets.toml and fill in the values.
# secrets.toml is gitignored. On Streamlit Community Cloud, paste the same
# lines into: App settings -> Secrets.
#
# All of this is OPTIONAL. Without it the app works in "latest completed
# session" mode using OpenF1's free historical data.
#
# Live (real-time) OpenF1 data needs a paid OpenF1 account. Either give
# your account login (recommended, the app refreshes the token itself)...
OPENF1_USERNAME = ""
OPENF1_PASSWORD = ""
#
# ...or a ready-made access token. Tokens expire after 1 hour, so this is
# only handy for quick tests.
OPENF1_API_KEY = ""
